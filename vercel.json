{
  "buildCommand": "node build.js",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/cubejs/:file",
      "destination": "https://cdn.jsdelivr.net/npm/cubejs@1.3.2/lib/:file"
    },
    {
      "source": "/r/:id",
      "destination": "/api/r?id=:id"
    },
    {
      "source": "/fridrich",
      "destination": "/fridrich.html"
    },
    {
      "source": "/principiante",
      "destination": "/principiante.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
